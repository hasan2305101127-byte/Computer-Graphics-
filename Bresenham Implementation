#include <stdio.h>
float x0, y0, x1, y1, x2, y2, x3, y3;
// Creating line using Bresenham
void drawLine(int x0, int y0, int x1, int y1) {
 int dx = x1 - x0;
 int dy = y1 - y0;
 // Khara bahu r jonno
 if (dx == 0) {
 glBegin(GL_POINTS);
 for (int y = y0; y <= y1; y++) {
 glVertex2i(x0, y);
 }
 glEnd();
 return;
 }
 int stepY = 1;
 if (dy < 0) {
 stepY = -1;
 dy = -dy;
 }
// Chader dan paser jonno dy negative hole y kombe
 if (dy < 0) {
stepY = -1;
 dy = -dy;
 }
 int p = 2 * dy - dx;
 int x = x0;
 int y = y0;
 glBegin(GL_POINTS); // Pixel drawing starts
 while (x <= x1) {
 glVertex2i(x, y);
 // Araari bahur logic (p < 0)
 if (p < 0) {
 x = x + 1;
 p = p + 2 * dy;
 }
 // Konakuni bahur logic (p >= 0)
 else {
 x = x + 1;
 y = y + stepY; // stepY onujayi y barbe ba kombe
 p = p + 2 * dy - 2 * dx;
 }
 }
 glEnd(); // glBegin থাকলে glEnd দেওয়া আবশ্যক
}
