#include <GL/gl.h>
#include <GL/glut.h>
#include <stdio.h>
#include <math.h>
// DDA Algorithm দিয়ে লাইনআঁকার ফাাংশন
void drawLineDDA(float x1, float y1, float x2, float y2)
{
 float dx = x2 - x1;
 float dy = y2 - y1;
 float steps ;
// ককান অক্ষ বরাবর পদরবর্তন কবদশ র্া কবর করা
 if (fabs(dx) > fabs(dy)) {
 steps = fabs(dx);
 } else {
 steps = fabs(dy);
 }
 float xIncrement = dx / steps;
 float yIncrement = dy / steps;
 float x = x1;
 float y = y1;
 glBegin(GL_POINTS);
 for (int i = 0; i <= steps; i++) {
 glVertex2i(round(x), round(y)); // দপয়েল ড্র করা
 x += xIncrement;
 y += yIncrement;
 }
 glEnd();
}
void display()
{
 glClear(GL_COLOR_BUFFER_BIT);
 glColor3f(0.0, 1.0, 0.0); // ঘয়রর রাং সবুজ (Green)
 // --- ঘয়রর চারয়কাণা বদি বা কিোল ---
 drawLineDDA(30, 20, 70, 20); // দনয়চর কেয়ে (Floor)
 drawLineDDA(30, 20, 30, 60); // বায়ের কিোল (Left Wall)
 drawLineDDA(70, 20, 70, 60); // িায়নর কিোল (Right Wall)
// --- ঘয়রর ত্রিভুজ ছাি (Roof) ---
 drawLineDDA(30, 60, 50, 85); // ছায়ির বাে পাশ
 drawLineDDA(70, 60, 50, 85); // ছায়ির িান পাশ
 glFlush();
}
void init()
{
 glClearColor(0.0, 0.0, 0.0, 0.0);
 glMatrixMode(GL_PROJECTION);
 glLoadIdentity();
 glOrtho(0, 100, 0, 100, -1, 1); // আপনার কসট করা ০ কেয়ক ১০০ গ্রাফ কেল
}
int main(int argc, char** argv)
{

 glutInit(&argc, argv);
 glutInitDisplayMode(GLUT_SINGLE | GLUT_RGB);
 glutInitWindowSize(600, 600);
 glutInitWindowPosition(100, 100);
 glutCreateWindow("DDA Line Drawing - House");
 init();
 glutDisplayFunc(display);
 glutMainLoop();
 return 0 ;
}
