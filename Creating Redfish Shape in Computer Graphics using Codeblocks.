#include <GL/gl.h>
#include <GL/glut.h>
void display(void)
{
glClear(GL_COLOR_BUFFER_BIT);
glColor3f(1.25, 0.25, 0.0);
glBegin(GL_POLYGON);
glVertex3f(0.20, 0.10, 0.0);
glVertex3f(0.10, 0.20, 0.0);
glVertex3f(0.20, 0.30, 0.0);
glVertex3f(0.40, 0.30, 0.0);
glVertex3f(0.50, 0.20, 0.0);
glVertex3f(0.40, 0.10, 0.0);
glVertex3f(0.30, 0.20, 0.0) ;
glVertex3f(0.20, 0.80, 0.0);
glEnd();
glutSwapBuffers();
}
void init(void)
{
glMatrixMode(GL_PROJECTION);
glLoadIdentity();
glOrtho(0.0, 1.0, 0.0, 1.0, -1.0, 1.0);
}
int main(int argc, char** argv)
{
glutInit(&argc, argv);
glutInitDisplayMode(GLUT_DOUBLE | GLUT_RGB);
glutInitWindowSize(500, 500);
glutInitWindowPosition(100, 100);
glutCreateWindow("hello");
init();
glutDisplayFunc(display);
glutMainLoop();
return 0;
}
